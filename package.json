{
  "name": "yipie",
  "description": "一瞥 YiPie：用你自己配置的 OpenAI 兼容模型服务总结当前网页的浏览器扩展",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lonemoonspace/YiPie.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:e2e": "wxt build --mode e2e",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gate": "npm run compile && npm run test && npm run lint && npm run format:check",
    "check:manifest": "node scripts/check-manifest.ts",
    "check:bundle": "node scripts/check-bundle-budget.ts",
    "test:e2e": "playwright test",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "eventsource-parser": "4.1.2",
    "marked": "18.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "~9.39.5",
    "@playwright/test": "1.56.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "~9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "30.1.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4",
    "wxt": "^0.21.4"
  }
}
